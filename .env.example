APP_NAME="Jehoven's Garden Resort"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jehovens
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# `log` writes mail to storage/logs/laravel.log and sends nothing — fine for development.
# Booking email is queued, so even with a real mailer below nothing leaves the server
# until a worker is running (`php artisan queue:work`). See the README.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production mail — uncomment and fill in. MAIL_FROM_ADDRESS has to be an address your
# provider lets you send as, or the mail is accepted and then quietly dropped.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="bookings@your-domain.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PayMongo. Every booking is paid for here — GCash, Maya, GrabPay and cards — and the
# payment reference it hands back is what the resort verifies a booking against.
# `sk_test_`/`pk_test_` keys drive the sandbox. The webhook secret is NOT in the
# dashboard: it comes back once, in the response to `POST /v1/webhooks`.
#
# Unpaid bookings hold their dates for PAYMONGO_HOLD_MINUTES and are then released by
# `resort:expire-unpaid-reservations`, which needs `schedule:run` on a cron.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_HOLD_MINUTES=60

# Default administrator seeded by AdminSeeder. Change before going live.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=password

# Where new-booking alerts are sent. Defaults to ADMIN_EMAIL.
# Booking mail only leaves the server once MAIL_MAILER is a real transport
# (it is `log` above) and a queue worker is running.
RESORT_NOTIFICATION_EMAIL=
