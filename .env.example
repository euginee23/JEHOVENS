APP_NAME="Jehoven's Garden Resort"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jehovens
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Booking email is queued, so it needs `php artisan queue:work` running. Where hosting
# will not run a daemon, set this to true and the scheduler drains the queue every minute
# instead — it already runs for the unpaid-booking sweeper. Leave it false if a real
# worker is running.
QUEUE_DRAIN_ON_SCHEDULE=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local mail goes to Mailpit, which catches everything and shows it at
# http://localhost:8025. No Mailpit? Set MAIL_MAILER=log to write mail into
# storage/logs/laravel.log instead — it needs nothing installed.
#
# Booking email is queued either way, so nothing appears until a worker is running.
# `composer dev` starts one; otherwise run `php artisan queue:work`. See the README.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bookings@jehovens.test"
MAIL_FROM_NAME="${APP_NAME}"

# Production mail — uncomment and fill in. MAIL_FROM_ADDRESS has to be an address your
# provider lets you send as, or the mail is accepted and then quietly dropped.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="bookings@your-domain.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PayMongo. Every booking is paid for here — GCash, Maya, GrabPay and cards — and the
# payment reference it hands back is what the resort verifies a booking against.
# `sk_test_`/`pk_test_` keys drive the sandbox. The webhook secret is NOT in the
# dashboard: it comes back once, in the response to `POST /v1/webhooks`.
#
# Unpaid bookings hold their dates for PAYMONGO_HOLD_MINUTES and are then released by
# `resort:expire-unpaid-reservations`, which needs `schedule:run` on a cron.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_HOLD_MINUTES=60

# Which payment methods to offer, comma separated. Required by PayMongo — there is no
# "offer everything" option, though it falls back to qrph when unset. QR Ph is the
# resort's active one: scanned with any bank or e-wallet app, settling over InstaPay.
# Naming a method the account does NOT have leaves the guest on a checkout page reading
# "No payment methods are available".
PAYMONGO_METHODS=qrph

# Default administrator seeded by AdminSeeder. Change before going live.
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=password

# Where new-booking alerts are sent. Defaults to ADMIN_EMAIL.
# Booking mail only reaches a real inbox once MAIL_MAILER points at a real transport
# (it points at Mailpit above, which catches it locally) and a queue worker is running.
RESORT_NOTIFICATION_EMAIL=

# Where `php artisan resort:mail-check` sends its test message. Point this at an inbox you
# can actually open — it proves the mail transport works on its own, before the queue is
# involved. Falls back to the address above when left blank.
RESORT_MAIL_TEST_ADDRESS=
